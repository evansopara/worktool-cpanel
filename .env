# ------------------------------------------------------------------
# Workapp - cPanel production environment
# Replace every CHANGE_ME value before going live. The previous
# database and Gmail secrets were exposed and must be rotated.
# ------------------------------------------------------------------
APP_NAME=Workapp
APP_ENV=production
APP_KEY=base64:UiGwpE9zzxh1w4BuEwS82AciI1lodskoE8/iWjtPfcw=
APP_DEBUG=false
APP_URL=https://workapp.wcdigitalagency.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Used in password-setup and notification e-mail links
FRONTEND_URL=https://workapp.wcdigitalagency.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanell prefixes database names and users with your account username,
# e.g. CPANELUSER_workapp. MySQL runs locally on cPanel hosts.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=wcdigital_workapp
DB_USERNAME=wcdigital_workapp
DB_PASSWORD=rzLlP*6_zLl0HYp~

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=workapp.wcdigitalagency.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Bare host name only (no https://, no trailing slash)
SANCTUM_STATEFUL_DOMAINS=workapp.wcdigitalagency.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=workapp.wcdigitalagency.com
MAIL_PORT=465
MAIL_USERNAME=notification@workapp.wcdigitalagency.com
# Generate a NEW Google App Password - the old one was exposed
MAIL_PASSWORD=WC@gency1
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="notification@workapp.wcdigitalagency.com"
MAIL_FROM_NAME="${APP_NAME}"


# Web Push (VAPID) - generate once, never rotate (rotating invalidates every device subscription)
VAPID_PUBLIC_KEY=BJH-IYddVhhgEex-JEvoC3cpQQtbvkXZw1hrLsF4nkcOrP2Vr7Xr4sVbgQvzCda0hkM0fl0xo4pUsoNujhrrSp0
